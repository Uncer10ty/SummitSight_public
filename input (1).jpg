/* CSS Variables */
:root {
    --primary-color: #2563eb;
    --primary-dark: #1e40af;
    --secondary-color: #10b981;
    --accent-color: #f59e0b;
    --text-primary: #1f2937;
    --text-secondary: #6b7280;
    --bg-light: #f9fafb;
    --bg-white: #ffffff;
    --border-color: #e5e7eb;
    --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    --transition: all 0.3s ease;
    --card-bg: var(--bg-white);
}

/* Dark Mode  */
[data-theme="dark"] {
    --primary-color: #3b82f6;
    --primary-dark: #2563eb;
    --secondary-color: #34d399;
    --accent-color: #fbbf24;
    --text-primary: #f1f5f9;
    --text-secondary: #94a3b8;
    --bg-light: #0f172a;
    --bg-white: #1e293b;
    --border-color: #334155;
    --card-bg: #1e293b;
    --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.4), 0 2px 4px -1px rgba(0, 0, 0, 0.3);
    --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.4), 0 4px 6px -2px rgba(0, 0, 0, 0.3);
}

[data-theme="dark"] img {
    opacity: 0.92;
}

[data-theme="dark"] .confidence-high {
    background-color: #064e3b;
    color: #6ee7b7;
}

[data-theme="dark"] .confidence-medium {
    background-color: #78350f;
    color: #fcd34d;
}

[data-theme="dark"] .confidence-low {
    background-color: #7f1d1d;
    color: #fca5a5;
}

[data-theme="dark"] .badge-green {
    background-color: #064e3b;
    color: #6ee7b7;
}

[data-theme="dark"] .badge-orange {
    background-color: #78350f;
    color: #fcd34d;
}

[data-theme="dark"] .explanation-good {
    background-color: #064e3b;
    color: #6ee7b7;
    border-left-color: #34d399;
}

[data-theme="dark"] .explanation-warn {
    background-color: #78350f;
    color: #fcd34d;
    border-left-color: #fbbf24;
}

[data-theme="dark"] .upload-area {
    border-color: #475569;
}

[data-theme="dark"] .upload-area:hover {
    border-color: var(--primary-color);
    background-color: #0f172a;
}

[data-theme="dark"] .upload-area.drag-over {
    border-color: var(--primary-color);
    background-color: #1e3a5f;
}

[data-theme="dark"] .cta-section {
    background: linear-gradient(135deg, #1e40af, #1e3a8a);
}

[data-theme="dark"] .tech-card,
[data-theme="dark"] .use-case {
    background-color: #0f172a;
    border-left-color: var(--primary-color);
}

/* Dark mode toggle button */
.theme-toggle {
    background: none;
    border: 2px solid var(--border-color);
    border-radius: 0.5rem;
    padding: 0 0.75rem;
    cursor: pointer;
    font-size: 1.2rem;
    line-height: 1;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition);
    color: var(--text-secondary);
}

.theme-toggle:hover {
    border-color: var(--primary-color);
    background-color: var(--bg-light);
}

/* ===== Reset & Base Styles ===== */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    color: var(--text-primary);
    background-color: var(--bg-light);
    line-height: 1.6;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}

/* Navigation  */
.navbar {
    background-color: var(--bg-white);
    box-shadow: var(--shadow);
    position: sticky;
    top: 0;
    z-index: 1100;
}

/* Keep Leaflet controls below navbar */
.leaflet-top,
.leaflet-bottom {
    z-index: 999 !important;
}

.nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo h1 {
    font-size: 1.5rem;
    color: var(--primary-color);
    font-weight: 700;
}

.nav-menu {
    display: flex;
    list-style: none;
    gap: 2rem;
    align-items: center;
}

.nav-menu li {
    display: flex;
    align-items: center;
}

.nav-menu a {
    text-decoration: none;
    color: var(--text-secondary);
    font-weight: 500;
    transition: var(--transition);
    padding: 0 1rem;
    border-radius: 0.375rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 40px;
    line-height: 1;
}

.nav-menu a:hover,
.nav-menu a.active {
    color: var(--primary-color);
    background-color: var(--bg-light);
}

/* Container  */
.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
    flex: 1;
}

/*  Hero Section */
.hero,
.about-hero,
.results-hero {
    text-align: center;
    margin-bottom: 3rem;
}

.hero h2,
.about-hero h2,
.results-hero h2 {
    font-size: 2.5rem;
    color: var(--text-primary);
    margin-bottom: 1rem;
    font-weight: 700;
}

.subtitle {
    font-size: 1.125rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto;
}

/*  Upload Section */
.upload-section {
    margin-bottom: 4rem;
    position: relative;
}

.upload-card {
    background-color: var(--bg-white);
    border-radius: 1rem;
    padding: 3rem;
    box-shadow: var(--shadow-lg);
}

.upload-area {
    border: 3px dashed var(--border-color);
    border-radius: 0.75rem;
    padding: 4rem 2rem;
    text-align: center;
    transition: var(--transition);
    cursor: pointer;
}

.upload-area:hover {
    border-color: var(--primary-color);
    background-color: var(--bg-light);
}

.upload-area.drag-over {
    border-color: var(--primary-color);
    background-color: #eff6ff;
}

.upload-icon {
    font-size: 4rem;
    margin-bottom: 1rem;
}

.upload-area h3 {
    color: var(--text-primary);
    margin-bottom: 0.5rem;
    font-size: 1.5rem;
}

.upload-area p {
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
}

/* Preview Area */
.preview-area {
    text-align: center;
}

.preview-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
}

.preview-header h3 {
    font-size: 1.5rem;
    color: var(--text-primary);
}

#previewImage {
    max-width: 100%;
    max-height: 500px;
    border-radius: 0.75rem;
    box-shadow: var(--shadow);
    margin-bottom: 1.5rem;
}

.image-info {
    background-color: var(--bg-light);
    padding: 1rem;
    border-radius: 0.5rem;
    margin-bottom: 1.5rem;
    color: var(--text-secondary);
}

/* Buttons */
.btn {
    padding: 0.75rem 1.5rem;
    border: none;
    border-radius: 0.5rem;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: var(--transition);
    text-decoration: none;
    display: inline-block;
}

.btn-primary {
    background-color: var(--primary-color);
    color: white;
}

.btn-primary:hover {
    background-color: var(--primary-dark);
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
}

.btn-secondary {
    background-color: var(--text-secondary);
    color: white;
}

.btn-secondary:hover {
    background-color: #4b5563;
}

.btn-large {
    padding: 1rem 2rem;
    font-size: 1.125rem;
}

.btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

/* Features Section */
.features {
    margin-bottom: 4rem;
}

.features h3 {
    text-align: center;
    font-size: 2rem;
    margin-bottom: 2rem;
    color: var(--text-primary);
}

.feature-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
}

.feature-card {
    background-color: var(--bg-white);
    padding: 2rem;
    border-radius: 0.75rem;
    box-shadow: var(--shadow);
    text-align: center;
    transition: var(--transition);
}

.feature-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
}

.feature-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
}

.feature-card h4 {
    color: var(--primary-color);
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
}

.feature-card p {
    color: var(--text-secondary);
}

/* Loading Overlay */
.loading-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.7);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    z-index: 2000;
}

.spinner {
    border: 4px solid rgba(255, 255, 255, 0.3);
    border-top: 4px solid white;
    border-radius: 50%;
    width: 50px;
    height: 50px;
    animation: spin 1s linear infinite;
}

@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

.loading-overlay p {
    color: white;
    margin-top: 1rem;
    font-size: 1.125rem;
}

/* ===== About Page ===== */
.about-content {
    max-width: 900px;
    margin: 0 auto;
}

.content-block {
    background-color: var(--bg-white);
    padding: 2rem;
    border-radius: 0.75rem;
    box-shadow: var(--shadow);
    margin-bottom: 2rem;
}

.content-block h3 {
    color: var(--primary-color);
    font-size: 1.75rem;
    margin-bottom: 1rem;
}

.content-block p {
    color: var(--text-secondary);
    margin-bottom: 1rem;
    line-height: 1.8;
}

.feature-list {
    list-style: none;
    padding-left: 0;
}

.feature-list li {
    color: var(--text-secondary);
    padding: 0.75rem 0;
    padding-left: 2rem;
    position: relative;
    line-height: 1.6;
}

.feature-list li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--secondary-color);
    font-weight: bold;
    font-size: 1.25rem;
}

.tech-grid,
.use-case-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-top: 1.5rem;
}

.tech-card,
.use-case {
    background-color: var(--bg-light);
    padding: 1.5rem;
    border-radius: 0.5rem;
    border-left: 4px solid var(--primary-color);
}

.tech-card h4,
.use-case h4 {
    color: var(--text-primary);
    margin-bottom: 0.5rem;
    font-size: 1.125rem;
}

.tech-card p,
.use-case p {
    color: var(--text-secondary);
    font-size: 0.875rem;
    margin: 0;
}

.use-case-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
}

.cta-section {
    background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
    color: white;
    padding: 3rem;
    border-radius: 0.75rem;
    text-align: center;
}

.cta-section h3 {
    color: white;
    font-size: 2rem;
    margin-bottom: 1rem;
}

.cta-section p {
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 2rem;
    font-size: 1.125rem;
}

.cta-section .btn {
    background-color: white;
    color: var(--primary-color);
}

.cta-section .btn:hover {
    background-color: var(--bg-light);
}

/* Results Page */
.results-section {
    max-width: 900px;
    margin: 0 auto;
}

.uploaded-image-card {
    background-color: var(--bg-white);
    padding: 2rem;
    border-radius: 0.75rem;
    box-shadow: var(--shadow);
    margin-bottom: 2rem;
    text-align: center;
}

.uploaded-image-card h3 {
    color: var(--text-primary);
    margin-bottom: 1.5rem;
    font-size: 1.5rem;
}

.uploaded-image-card img {
    max-width: 100%;
    max-height: 400px;
    border-radius: 0.5rem;
}

.results-card {
    background-color: var(--bg-white);
    padding: 2rem;
    border-radius: 0.75rem;
    box-shadow: var(--shadow);
    margin-bottom: 2rem;
}

.result-item {
    padding: 1.5rem;
    border-radius: 0.5rem;
    border: 2px solid var(--border-color);
    margin-bottom: 1rem;
    transition: var(--transition);
}

.result-item:hover {
    border-color: var(--primary-color);
    box-shadow: var(--shadow);
}

.result-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
}

.result-location {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
}

.result-rank-chip {
    display: inline-flex;
    align-items: center;
    color: #ffffff;
    border-radius: 999px;
    font-size: 0.76rem;
    font-weight: 700;
    padding: 0.22rem 0.6rem;
    letter-spacing: 0.02em;
}

.rank-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    margin-bottom: 1rem;
}

.rank-legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background-color: var(--bg-light);
    border: 1px solid var(--border-color);
    border-radius: 999px;
    padding: 0.2rem 0.55rem;
    color: var(--text-secondary);
    font-size: 0.75rem;
}

.rank-legend-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    display: inline-block;
}

.confidence-badge {
    padding: 0.375rem 0.75rem;
    border-radius: 2rem;
    font-size: 0.875rem;
    font-weight: 600;
}

.confidence-high {
    background-color: #d1fae5;
    color: #065f46;
}

.confidence-medium {
    background-color: #fef3c7;
    color: #92400e;
}

.confidence-low {
    background-color: #fee2e2;
    color: #991b1b;
}

.result-details {
    color: var(--text-secondary);
    line-height: 1.8;
}

.result-details p {
    margin-bottom: 0.5rem;
}

.no-results {
    text-align: center;
    padding: 3rem;
    color: var(--text-secondary);
}

.no-results h3 {
    color: var(--text-primary);
    margin-bottom: 1rem;
}

.actions {
    text-align: center;
    margin-top: 2rem;
}

/* Footer */
.footer {
    background-color: var(--bg-white);
    border-top: 1px solid var(--border-color);
    padding: 2rem;
    text-align: center;
    color: var(--text-secondary);
    margin-top: auto;
}

/* Responsive Design */
@media (max-width: 768px) {
    .nav-container {
        flex-direction: column;
        gap: 1rem;
    }

    .hero h2,
    .about-hero h2,
    .results-hero h2 {
        font-size: 2rem;
    }

    .upload-card {
        padding: 1.5rem;
    }

    .upload-area {
        padding: 2rem 1rem;
    }

    .feature-grid,
    .tech-grid,
    .use-case-grid {
        grid-template-columns: 1fr;
    }

    .container {
        padding: 1rem;
    }
}

@media (max-width: 480px) {
    .logo h1 {
        font-size: 1.25rem;
    }

    .hero h2,
    .about-hero h2,
    .results-hero h2 {
        font-size: 1.5rem;
    }

    .subtitle {
        font-size: 1rem;
    }

    .btn {
        width: 100%;
    }
}

/* Skyline Approval Area */
.approval-area {
    text-align: center;
}

.approval-hint {
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
}

.comparison-container {
    display: flex;
    justify-content: center;
    margin-bottom: 1.5rem;
}

.comparison-item {
    text-align: center;
}

.comparison-item h4 {
    color: var(--text-primary);
    margin-bottom: 0.75rem;
    font-size: 1rem;
}

.comparison-item img {
    max-width: 100%;
    max-height: 450px;
    border-radius: 0.5rem;
    box-shadow: var(--shadow);
    object-fit: contain;
}

/* FOV slider */
.fov-control {
    max-width: 760px;
    margin: 0 auto 1.5rem;
    text-align: left;
}

.fov-control input[type="range"] {
    width: 100%;
    margin-bottom: 1.5rem;
}

.fov-control label {
    display: block;
    color: var(--text-primary);
    font-weight: 600;
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
}

.fov-control .slider-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    max-width: 760px;
    margin: 0 auto;
}

.fov-control input[type="range"] {
    flex: 1;
    -webkit-appearance: none;
    appearance: none;
    height: 8px;
    border-radius: 4px;
    background: var(--border-color);
    outline: none;
    transition: background 0.2s;
}

.fov-control input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--primary-color);
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
    border: 2px solid var(--bg-white);
    margin-top: -7px;
}

.fov-control input[type="range"]::-moz-range-thumb {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--primary-color);
    cursor: pointer;
    border: 2px solid var(--bg-white);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
}

.fov-control input[type="range"]::-webkit-slider-runnable-track {
    height: 8px;
    border-radius: 4px;
}

.fov-control input[type="range"]::-moz-range-track {
    height: 8px;
    border-radius: 4px;
    background: var(--border-color);
}

[data-theme="dark"] .fov-control input[type="range"] {
    background: #475569;
}

[data-theme="dark"] .fov-control input[type="range"]::-moz-range-track {
    background: #475569;
}

.fov-control .fov-val {
    min-width: 3ch;
    text-align: center;
    font-weight: 700;
    font-size: 1rem;
    color: var(--primary-color);
}

.fov-hints {
    display: flex;
    justify-content: space-between;
    width: 100%;
    margin: 0.25rem auto 0;
    font-size: 0.75rem;
    color: var(--text-secondary);
}

.approval-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
}

.method-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: 2rem;
    font-size: 0.8rem;
    font-weight: 600;
}

.badge-green {
    background-color: #d1fae5;
    color: #065f46;
}

.badge-orange {
    background-color: #fef3c7;
    color: #92400e;
}

.badge-blue {
    background-color: #dbeafe;
    color: #1e3a8a;
}

/* Loading Stage Text */
.loading-stage {
    color: rgba(255, 255, 255, 0.7);
    margin-top: 0.5rem;
    font-size: 0.875rem;
}

/* Progress Bar (loading overlay) */
.progress-bar-container {
    margin-top: 1rem;
    width: 300px;
    max-width: 80vw;
    background-color: rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    height: 6px;
    position: relative;
    overflow: hidden;
}

.progress-bar-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
    border-radius: 4px;
    transition: width 0.4s ease;
}

.progress-text {
    display: block;
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.75rem;
    text-align: center;
    margin-top: 0.35rem;
}

/* Method Explanation */
.method-explanation {
    font-size: 0.85rem;
    line-height: 1.5;
    padding: 0.6rem 0.9rem;
    border-radius: 0.5rem;
    margin-bottom: 0.75rem;
}

.explanation-good {
    background-color: #ecfdf5;
    color: #065f46;
    border-left: 3px solid #10b981;
}

.explanation-warn {
    background-color: #fffbeb;
    color: #92400e;
    border-left: 3px solid #f59e0b;
}

/* Performance Summary */
.performance-summary {
    background-color: var(--bg-white);
    padding: 1.5rem 2rem;
    border-radius: 0.75rem;
    box-shadow: var(--shadow);
    margin-bottom: 2rem;
}

.performance-summary h3 {
    color: var(--text-primary);
    margin-bottom: 1rem;
    font-size: 1.25rem;
}

.perf-row {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
}

.perf-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
}

.perf-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-secondary);
    font-weight: 600;
}

.perf-value {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    font-family: 'Courier New', Courier, monospace;
}

/* Alignment Legend */
.alignment-legend {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--text-secondary);
}

.legend-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
}

.legend-swatch {
    display: inline-block;
    width: 16px;
    height: 3px;
    border-radius: 2px;
}

/* Results Page: Image Comparison Card */
.image-comparison-card {
    background-color: var(--bg-white);
    padding: 2rem;
    border-radius: 0.75rem;
    box-shadow: var(--shadow);
    margin-bottom: 2rem;
}

/* Results Page: Map Card */
.map-card {
    background-color: var(--bg-white);
    padding: 2rem;
    border-radius: 0.75rem;
    box-shadow: var(--shadow);
    margin-bottom: 2rem;
}

.map-card h3 {
    color: var(--text-primary);
    margin-bottom: 1rem;
    font-size: 1.5rem;
}

/* Metrics Row */
.metrics-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-color);
}

.metric {
    background-color: var(--bg-light);
    padding: 0.25rem 0.6rem;
    border-radius: 0.25rem;
    font-size: 0.8rem;
    color: var(--text-secondary);
    font-family: 'Courier New', Courier, monospace;
    cursor: help;
}

/* Responsive */
@media (max-width: 768px) {
    .approval-actions {
        flex-direction: column;
    }

    .metrics-row {
        flex-direction: column;
        gap: 0.5rem;
    }

    .perf-row {
        flex-direction: column;
        gap: 1rem;
    }

    .alignment-legend {
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
    }
}

/* Alignment Charts (inline under each candidate) */
.alignment-chart-wrapper {
    margin-bottom: 1.5rem;
    border: 1px solid var(--border-color);
    border-radius: 0.5rem;
    padding: 1rem;
    background-color: var(--bg-light);
}

.alignment-chart-heading {
    font-size: 0.95rem;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
    font-weight: 600;
}

.alignment-canvas {
    width: 100%;
    border-radius: 0.375rem;
    display: block;
}

.btn-alignment-toggle {
    display: inline-block;
    margin-top: 0.75rem;
    padding: 0.35rem 0.75rem;
    background: none;
    border: 1px solid var(--border-color);
    border-radius: 0.375rem;
    color: var(--primary-color);
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: var(--transition);
}

.btn-alignment-toggle:hover {
    background-color: var(--bg-light);
    border-color: var(--primary-color);
}

.alignment-inline-container {
    margin-top: 0.75rem;
    padding: 0.75rem;
    border: 1px solid var(--border-color);
    border-radius: 0.5rem;
    background-color: var(--bg-light);
}

/* Admin Dashboard */
.admin-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 2rem;
}

.admin-stat-card {
    background-color: var(--bg-white);
    padding: 1.5rem;
    border-radius: 0.75rem;
    box-shadow: var(--shadow);
    text-align: center;
}

.admin-stat-card .stat-icon {
    font-size: 2rem;
    margin-bottom: 0.5rem;
}

.admin-stat-card .stat-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-secondary);
    font-weight: 600;
    margin-bottom: 0.25rem;
}

.admin-stat-card .stat-value {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    font-family: 'Courier New', Courier, monospace;
}

.status-indicator {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    margin-right: 0.5rem;
}

.status-indicator.green { background-color: #10b981; }
.status-indicator.red   { background-color: #ef4444; }
.status-indicator.amber { background-color: #f59e0b; }

.admin-section {
    background-color: var(--bg-white);
    padding: 2rem;
    border-radius: 0.75rem;
    box-shadow: var(--shadow);
    margin-bottom: 2rem;
}

.admin-section h3 {
    color: var(--text-primary);
    margin-bottom: 1rem;
    font-size: 1.25rem;
}

.admin-table {
    width: 100%;
    border-collapse: collapse;
}

.admin-table th,
.admin-table td {
    padding: 0.75rem 1rem;
    text-align: left;
    border-bottom: 1px solid var(--border-color);
    font-size: 0.9rem;
}

.admin-table th {
    color: var(--text-secondary);
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
}

.admin-table td {
    color: var(--text-primary);
    font-family: 'Courier New', Courier, monospace;
}

.admin-refresh-info {
    font-size: 0.8rem;
    color: var(--text-secondary);
    text-align: center;
    margin-top: 1rem;
}

/* Pipeline Walkthrough Animation */
.pipeline-steps {
    display: flex;
    gap: 0;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    margin: 2rem 0;
    padding: 1rem 0;
}

.pipeline-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1rem;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s ease, transform 0.5s ease;
    min-width: 110px;
}

.pipeline-step.visible {
    opacity: 1;
    transform: translateY(0);
}

.pipeline-step-icon {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
    color: white;
    box-shadow: var(--shadow);
}

.pipeline-step-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-primary);
    max-width: 90px;
}

.pipeline-step-desc {
    font-size: 0.7rem;
    color: var(--text-secondary);
    margin-top: 0.25rem;
    max-width: 100px;
}

.pipeline-arrow {
    font-size: 1.5rem;
    color: var(--primary-color);
    opacity: 0;
    transition: opacity 0.5s ease 0.2s;
    margin: 0 0.25rem;
}

.pipeline-arrow.visible {
    opacity: 1;
}

/* Example Gallery */
.example-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
}

.example-card {
    background-color: var(--bg-light);
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: var(--transition);
    text-align: center;
    text-decoration: none;
}

.example-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
}

.example-card img {
    width: 100%;
    height: 160px;
    object-fit: cover;
}

.example-card .example-info {
    padding: 1rem;
}

.example-card .example-info h4 {
    color: var(--text-primary);
    margin-bottom: 0.25rem;
    font-size: 1rem;
}

.example-card .example-info p {
    color: var(--text-secondary);
    font-size: 0.8rem;
    margin: 0;
}

.gallery-cta-wrap {
    margin-top: 1rem;
    text-align: center;
}

.confidence-breakdown {
    border: 1px solid var(--border-color);
}

.confidence-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
    margin: 1rem 0;
}

.confidence-factor {
    background-color: var(--bg-light);
    border-radius: 0.6rem;
    padding: 0.9rem;
    border-left: 4px solid var(--primary-color);
}

.confidence-factor h4 {
    color: var(--text-primary);
    margin-bottom: 0.35rem;
    font-size: 0.95rem;
}

.confidence-factor p {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.55;
}

.confidence-formula {
    background: linear-gradient(90deg, rgba(37, 99, 235, 0.12), rgba(16, 185, 129, 0.12));
    border: 1px solid var(--border-color);
    border-radius: 0.55rem;
    padding: 0.75rem 0.9rem;
    margin-top: 0.5rem;
    font-size: 0.86rem;
    color: var(--text-primary);
    font-family: 'Courier New', Courier, monospace;
}

/* Coverage Map */
.coverage-map-container {
    height: 350px;
    border-radius: 0.5rem;
    margin-top: 1rem;
    overflow: hidden;
}

/* Interactive Gallery Page */
.gallery-hero {
    margin-bottom: 2rem;
}

.gallery-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
    max-width: 980px;
    margin: 0 auto;
}

.gallery-card {
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.08), rgba(16, 185, 129, 0.08));
    border: 1px solid var(--border-color);
    border-radius: 0.9rem;
    box-shadow: var(--shadow);
    padding: 1.2rem;
}

.gallery-card-head h3 {
    color: var(--text-primary);
    margin-bottom: 0.2rem;
}

.gallery-card-head p {
    color: var(--text-secondary);
    margin-bottom: 0.8rem;
    font-size: 0.92rem;
}

.gallery-step-track {
    display: flex;
    gap: 0.55rem;
    flex-wrap: wrap;
    margin-bottom: 0.9rem;
}

.gallery-step-pill {
    border: 1px solid var(--border-color);
    background-color: var(--bg-white);
    color: var(--text-secondary);
    border-radius: 999px;
    font-size: 0.76rem;
    padding: 0.25rem 0.6rem;
    cursor: pointer;
    transition: var(--transition);
}

.gallery-step-pill:hover,
.gallery-step-pill.active {
    border-color: var(--primary-color);
    color: var(--primary-color);
    box-shadow: var(--shadow);
}

.gallery-stage-panel {
    background-color: var(--bg-white);
    border: 1px solid var(--border-color);
    border-radius: 0.8rem;
    padding: 0.8rem;
}

.gallery-stage-title {
    color: var(--text-primary);
    font-weight: 600;
    margin-bottom: 0.7rem;
}

.gallery-stage-image {
    width: 100%;
    border-radius: 0.6rem;
    border: 1px solid var(--border-color);
    box-shadow: var(--shadow);
    object-fit: cover;
    max-height: 360px;
}

.gallery-stage-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 0.8rem;
    align-items: start;
}

.gallery-stage-grid.two-up {
    grid-template-columns: 1fr 1fr;
}

.gallery-location-list {
    margin: 0;
    padding: 0.6rem 0.7rem 0.6rem 1.2rem;
    border-radius: 0.6rem;
    background-color: var(--bg-light);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    font-size: 0.82rem;
}

.gallery-location-list li {
    margin-bottom: 0.35rem;
}

.gallery-actions {
    display: flex;
    gap: 0.65rem;
    margin-top: 0.9rem;
    flex-wrap: wrap;
}

.gallery-image-missing {
    border-style: dashed;
}

@media (max-width: 768px) {
    .pipeline-steps {
        flex-direction: column;
    }
    .pipeline-arrow {
        transform: rotate(90deg);
    }
    .admin-grid {
        grid-template-columns: 1fr 1fr;
    }

    .gallery-stage-grid,
    .gallery-stage-grid.two-up {
        grid-template-columns: 1fr;
    }

    .confidence-grid {
        grid-template-columns: 1fr;
    }

    .rank-legend {
        flex-direction: column;
        align-items: flex-start;
    }
}

@media (max-width: 480px) {
    .admin-grid {
        grid-template-columns: 1fr;
    }
}
